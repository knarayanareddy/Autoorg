{
  "name": "autoorg",
  "version": "0.1.0",
  "description": "Autonomous Research Organization Engine \u2014 You write the mission. The agents run the company.",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "api": "bun run src/api/server.ts",
    "migrate": "bun run scripts/ci/migrate-all.ts",
    "privacy:sanitize": "bun run src/scripts/sanitize-legacy-privacy.ts",
    "providers:encrypt": "bun run src/scripts/encrypt-provider-keys.ts",
    "migrate:verify": "bun run scripts/ci/migrate-all.ts --verify",
    "lint": "bun run scripts/ci/lint.ts",
    "typecheck": "bun run scripts/ci/typecheck.ts",
    "test:ci": "bun run scripts/ci/test-unit.ts",
    "health": "bun run scripts/ci/health-check.ts",
    "smoke": "bun run scripts/ci/smoke-test.ts",
    "security": "bun run scripts/ci/security-scan.ts",
    "audit": "bun run scripts/ci/dependency-audit.ts",
    "setup:hooks": "git config core.hooksPath scripts/hooks && chmod +x scripts/hooks/*",
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "init": "bun run src/scripts/init.ts",
    "run:org": "bun run src/index.ts --org org.md",
    "test": "bun test",
    "db:migrate": "bun run src/db/migrate.ts",
    "clean": "rm -rf dist test-results .ci autoorg.db autoorg.db-shm autoorg.db-wal",
    "build": "bun build src/index.ts src/api/server.ts --target=bun --outdir=dist --external react-devtools-core",
    "build:web": "cd web && bun run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.1",
    "glob": "^14.0.3",
    "gray-matter": "^4.0.3",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "marked": "^11.1.1",
    "nanoid": "^5.1.16",
    "node-fetch": "^3.3.2",
    "openai": "^4.86.1",
    "p-limit": "^5.0.0",
    "react": "^18.2.0",
    "simple-git": "^4.0.1",
    "tsx": "^4.23.15",
    "yaml": "^2.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
