# ============================================================
# AutoOrg — Environment Configuration
# Copy this file to .env and fill in your keys
# ============================================================

# ── API SECURITY ─────────────────────────────────────────────
# Required for any bind other than 127.0.0.1. The server REFUSES to start on a
# public interface without it, because the approval endpoints can commit code.
# Clients send it as `Authorization: Bearer <key>` or `x-api-key: <key>`.
AUTOORG_API_KEY=

# Optional 32-byte random hex key for encrypting DB-stored provider credentials.
# Generate with: openssl rand -hex 32
# Keep outside the database and back it up securely; loss makes credentials unreadable.
AUTOORG_PROVIDER_ENCRYPTION_KEY=
# Bind address. Default 0.0.0.0; use 127.0.0.1 for local-only.
API_HOST=0.0.0.0
API_PORT=3001
# Comma-separated origin allowlist for the dashboard. Empty = same-origin only.
# Wildcard CORS is never used.
AUTOORG_CORS_ORIGINS=
# GitHub webhook secret. Webhooks are rejected (503) when this is unset.
GITHUB_WEBHOOK_SECRET=

# ── ARTIFACT SIGNING ───────────────────────────────────────────────────
# REQUIRED by the runner (`bun start`): artifact signatures fail closed and
# startup aborts when it is missing or empty. Generate with `openssl rand -hex 32`.
AUTOORG_SIGNING_SECRET=

# ── WEB FETCH (SSRF guard) ─────────────────────────────────────────────
# Optional comma-separated host allowlist for web.fetch (exact host or
# *.suffix). Empty = any public host; loopback/private/link-local
# addresses and non-http(s) schemes are always blocked.
AUTOORG_FETCH_HOST_ALLOWLIST=

# ── LLM PROVIDER (choose one or mix per agent) ─────────────
# Options: "anthropic" | "openai" | "ollama" | "groq" | "together"
DEFAULT_LLM_PROVIDER=anthropic

# Provider keys may also be given the legacy AUTOORG_API_KEY_<PROVIDER> name.
# The documented names below are preferred.

# ── ANTHROPIC ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Override for proxies / gateways.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── OPENAI / OPENAI-COMPATIBLE ───────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# Point at LM Studio, Together, vLLM, etc.
OPENAI_BASE_URL=https://api.openai.com/v1

# ── GROQ (fast + cheap) ──────────────────────────────────────
GROQ_API_KEY=gsk_your-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── TOGETHER AI ──────────────────────────────────────────────
TOGETHER_API_KEY=your-key-here
TOGETHER_BASE_URL=https://api.together.xyz/v1

# ── OLLAMA (local, zero cost) ────────────────────────────────
# Make sure Ollama is running: `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:32b

# ── GOOGLE GEMINI ────────────────────────────────────────────
GEMINI_API_KEY=your-key-here

# ── DATABASE ─────────────────────────────────────────────────
# SQLite path. AUTOORG_DB_PATH takes precedence when both are set.
DB_PATH=./autoorg.db
# NEO4J_URI=bolt://localhost:7687   # Uncomment for Phase 4
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password

# ── AUTOORG SETTINGS ─────────────────────────────────────────
AUTOORG_WORKSPACE=./workspace
AUTOORG_MEMORY_DIR=./memory
AUTOORG_MAILBOX_DIR=./mailbox
AUTOORG_ROLES_DIR=./roles
# debug | info | warn | error
AUTOORG_LOG_LEVEL=info
AUTOORG_MAX_RETRIES=3
AUTOORG_RETRY_DELAY_MS=2000

# ── GIT SETTINGS ─────────────────────────────────────────────
GIT_AUTHOR_NAME=AutoOrg
GIT_AUTHOR_EMAIL=autoorg@localhost
# ─────────────────────────────────────────────────────────────
# Usage:
#   cp .env.example .env
#   # fill in the keys you actually have, then:
#   bun run db:migrate
#   bun run src/scripts/seed-providers.ts

